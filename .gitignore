# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies (all workspaces)
node_modules
**/node_modules
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
**/coverage

# next.js
.next
**/.next
/out/
**/out

# production / build outputs
/build
**/dist
**/build
apps/**/dist
packages/**/dist

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# local debug output
*.txt
full-error.txt
test-output.txt

# env files (can opt-in for committing if needed)
.env*
.env.local*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
**/next-env.d.ts
